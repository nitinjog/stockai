# Reference only: the app reads real environment variables (export them) or the Settings page. No .env loader.
# Default provider. One Google key covers research, script, images and voice.
GEMINI_API_KEY=
# Optional alternatives (selectable per stage in Settings)
OPENAI_API_KEY=
# Anthropic is text only: no image or voice generation
ANTHROPIC_API_KEY=
# Where runs, settings and exports are stored (default: ./data)
# VIDEOGEN_DATA=./data
